# PostgreSQL — ajuste conforme seu ambiente local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/equili

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-valor-secreto-aleatorio

# OpenRouter (IA) — API compatível com OpenAI — https://openrouter.ai/settings/keys
# Modelos gratuitos (:free) — https://openrouter.ai/models?max_price=0
# O primário precisa suportar response_format (JSON mode) para o Plano de Ação.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
# Desliga o "thinking" (modelos de raciocínio) para não truncar o JSON. Se o modelo
# exigir reasoning, o cliente reenvia automaticamente a chamada sem o parâmetro.
OPENROUTER_DISABLE_REASONING=true

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Resend (e-mail transacional) — opcional em dev
RESEND_API_KEY=re_seu_api_key_aqui

# Stripe — opcional em dev
STRIPE_SECRET_KEY=sk_test_seu_key_aqui

# Pagamentos / assinaturas
# PAYMENT_GATEWAY=mock -> checkout simulado (ambiente de teste).
# PAYMENT_MOCK_KEY -> assina o webhook do gateway mock (x-equili-mock).
PAYMENT_GATEWAY=mock
PAYMENT_MOCK_KEY=equili-mock-dev
PAYMENT_CHECKOUT_EXPIRA_MINUTOS=30

# Social Auth — opcional
GOOGLE_CLIENT_ID=
APPLE_ALLOWED_AUDIENCES=com.equili.app

# Rate limiting de IA
RATE_LIMIT_AI_REQUESTS=20
RATE_LIMIT_AI_WINDOW_SECONDS=60

# Redis (opcional) — usado para rate limiting distribuído entre instâncias
REDIS_URL=redis://localhost:6379/0

# Rastro (observabilidade)
RASTRO_ENABLED=true
RASTRO_INGEST_URL=http://localhost:4000/ingest/errors
RASTRO_INGEST_TOKEN=acme-equili-dev-token
RASTRO_ORGANIZATION_SLUG=acme
RASTRO_PROJECT_SLUG=equili
RASTRO_ENVIRONMENT=development
RASTRO_RELEASE=equili-dev
