# ============================================================
# Backend
# ============================================================

# PostgreSQL — ajuste conforme seu ambiente local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/equili

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-valor-secreto-aleatorio

# OpenRouter (IA) — https://openrouter.ai/settings/keys
# Modelos gratuitos (:free) — https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=sk-or-v1-sua_chave_aqui
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_DISABLE_REASONING=true

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Resend (e-mail transacional) — opcional em dev
RESEND_API_KEY=re_seu_api_key_aqui

# Stripe — opcional em dev
STRIPE_SECRET_KEY=sk_test_seu_key_aqui

# Social Auth — opcional
GOOGLE_CLIENT_ID=
APPLE_ALLOWED_AUDIENCES=com.equili.app

# Rate limiting de IA
RATE_LIMIT_AI_REQUESTS=20
RATE_LIMIT_AI_WINDOW_SECONDS=60

# Redis (opcional) — usado para rate limiting distribuído entre instâncias
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Frontend
# ============================================================
# Use o arquivo frontend/.env.example para variáveis públicas (VITE_)
