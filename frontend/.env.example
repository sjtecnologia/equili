# Variáveis públicas do frontend (Vite)
# Tudo que começa com VITE_ pode ser exposto no bundle do navegador.

# Base da API consumida pelo cliente em produção.
# Em desenvolvimento, o Vite proxy de /api já atende o fluxo local.
VITE_API_URL=http://localhost:8000

# Google Sign-In (app mobile) — client ID do tipo WEB do Google Cloud Console.
# Usado no GoogleSignIn.initialize(); o client ID do tipo iOS vai em
# ios/App/App/Info.plist (chave GIDClientID).
VITE_GOOGLE_SERVER_CLIENT_ID=
